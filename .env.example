# Copy thành .env cùng thư mục docker-compose.yml (local hoặc ~/luxe2/luxe_backend/.env trên EC2).
# KHÔNG commit file .env. Tạo secret ngẫu nhiên: openssl rand -hex 32

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=luxe_fashion
MYSQL_USER=luxe_user
MYSQL_PASSWORD=change-me-app-password
# 0.0.0.0 = cho phép Workbench kết nối từ ngoài (nhớ giới hạn Security Group "My IP")
# 127.0.0.1 = đóng cổng 3306 với Internet (khi đó dùng Workbench qua SSH tunnel)
MYSQL_BIND=0.0.0.0
MYSQL_PUBLIC_PORT=3306

# ---------- Backend ----------
JWT_SECRET=change-me-openssl-rand-hex-32
BACKEND_PORT=5000
# URL truy cập frontend (dùng cho CORS / redirect nếu backend cần), vd: http://13.250.x.x
FRONTEND_URL=http://localhost

# ---------- Email (OTP quên mật khẩu) ----------
# ses  = AWS SES, EC2 dùng IAM role của máy (không cần key). MAIL_FROM phải là email/domain đã verify trong SES
# smtp = SMTP bất kỳ, vd Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=ban@gmail.com SMTP_PASS=<App Password 16 ký tự>
# để trống = không gửi mail, mã OTP chỉ ghi vào log backend (docker compose logs backend)
MAIL_PROVIDER=
MAIL_FROM=LUXE <no-reply@luxe.vn>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true = trả mã OTP trong response khi chưa cấu hình mail (CHỈ dùng khi dev/test, KHÔNG bật trên server thật)
OTP_DEBUG=false

# ---------- Frontend ----------
# Cổng public của Nginx: 80 trên EC2, có thể đổi thành 3000 khi chạy local
FRONTEND_PORT=80
# Build-time cho Vite. Để trống để dùng Nginx proxy /api (khuyến nghị)
VITE_API_URL=

